#!/usr/bin/env python3
"""Selecciona una imagen y un workspace, genera y guarda su tema."""

import importlib.util
import json
import shutil
import subprocess
import sys
from pathlib import Path

from PIL import Image


QTILE_DIR = Path.home() / ".config" / "qtile"
THEMES_FILE = QTILE_DIR / "workspace-themes.json"
WALLPAPERS_DIR = QTILE_DIR / "workspace-wallpapers"
LOCK_WALLPAPER = Path(
    "/usr/share/lightdm-webkit/themes/glorious/assets/bg.jpg"
)
WORKSPACES = ("I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX")


def choose_image():
    result = subprocess.run(
        [
            "zenity", "--file-selection", "--title=Selecciona un wallpaper",
            "--file-filter=Imágenes | *.png *.jpg *.jpeg *.webp *.bmp",
            "--file-filter=Todos los archivos | *",
        ],
        check=False,
        text=True,
        capture_output=True,
    )
    return Path(result.stdout.strip()).expanduser() if result.returncode == 0 else None


def choose_workspace():
    result = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "Workspace"],
        input="\n".join(WORKSPACES) + "\n",
        check=False,
        text=True,
        capture_output=True,
    )
    selected = result.stdout.strip().upper()
    return selected if result.returncode == 0 and selected in WORKSPACES else None


def generate_palette(image):
    spec = importlib.util.spec_from_file_location("walltheme_generator", QTILE_DIR / "theme.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module.generate_theme(module.get_dominant_colors(str(image), k=8))


def persist_wallpaper(workspace, image):
    """Conserva una copia administrada que no dependa de Descargas."""
    WALLPAPERS_DIR.mkdir(parents=True, exist_ok=True)
    suffix = image.suffix.lower() or ".png"
    target = WALLPAPERS_DIR / f"{workspace}{suffix}"
    temporary = target.with_name(target.name + ".tmp")
    shutil.copy2(image, temporary)
    temporary.replace(target)
    return target


def save_theme(workspace, image, palette):
    try:
        data = json.loads(THEMES_FILE.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        data = {}
    data[workspace] = {"wallpaper": str(image.resolve()), "palette": palette}
    temporary = THEMES_FILE.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    temporary.replace(THEMES_FILE)


def sync_lock_wallpaper(workspace, image):
    """El workspace I es la fuente preferida del fondo de LightDM."""
    if workspace != "I":
        return True
    try:
        with Image.open(image) as source:
            source.convert("RGB").save(
                LOCK_WALLPAPER, format="JPEG", quality=92, optimize=True
            )
        return True
    except OSError:
        return False


def apply_if_current(workspace):
    expression = (
        "__import__('settings.workspace_theme', "
        "fromlist=['apply_workspace_theme']).apply_workspace_theme(self, "
        f"'{workspace}') if self.current_group.name.strip() == '{workspace}' else None"
    )
    subprocess.run(
        ["qtile", "cmd-obj", "-o", "cmd", "-f", "eval", "-a", expression],
        check=False,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def notify(message, error=False):
    subprocess.run(
        ["notify-send", "walltheme", message] + (["--urgency=critical"] if error else []),
        check=False,
    )


def main():
    image = choose_image()
    if image is None:
        return 0
    if not image.is_file():
        notify("La imagen seleccionada no existe", error=True)
        return 1
    workspace = choose_workspace()
    if workspace is None:
        return 0
    try:
        persistent_image = persist_wallpaper(workspace, image)
        palette = generate_palette(persistent_image)
        save_theme(workspace, persistent_image, palette)
        lock_synced = sync_lock_wallpaper(workspace, persistent_image)
        apply_if_current(workspace)
    except Exception as error:
        notify(f"No se pudo generar el tema: {error}", error=True)
        return 1
    message = f"Tema guardado para el workspace {workspace}"
    if workspace == "I":
        message += (
            " y pantalla de bloqueo actualizada"
            if lock_synced
            else " (no se pudo actualizar la pantalla de bloqueo)"
        )
    notify(message, error=workspace == "I" and not lock_synced)
    return 0


if __name__ == "__main__":
    sys.exit(main())
