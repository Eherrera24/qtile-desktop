#!/bin/sh
set -eu

profile_root="$HOME/.config/desktop-profiles"
active_file="$profile_root/active"
qtile_target="$HOME/.config/qtile"
picom_target="$HOME/.config/picom/picom.conf"
kitty_target="$HOME/.config/kitty/kitty.conf"

usage() {
    printf '%s\n' \
        "Uso: desktop-profile premium|original|original-temas|toggle|status [--apply]" \
        "  premium   Tema dinámico y apariencia actual" \
        "  original  Configuración previa al primer respaldo" \
        "  original-temas  Apariencia original con wallpapers y colores por workspace" \
        "  toggle    Alterna entre ambos perfiles" \
        "  status    Muestra el perfil activo"
}

active="premium"
if [ -f "$active_file" ]; then
    active=$(tr -d '[:space:]' < "$active_file")
fi

command_name="${1:-status}"
apply_now="${2:-}"

if [ "$command_name" = "status" ]; then
    printf 'Perfil activo: %s\n' "$active"
    exit 0
fi

if [ "$command_name" = "toggle" ]; then
    if [ "$active" = "premium" ]; then
        command_name="original"
    else
        command_name="premium"
    fi
fi

case "$command_name" in
    premium|original|original-temas) ;;
    *) usage; exit 2 ;;
esac

if [ "$command_name" = "$active" ]; then
    printf 'El perfil %s ya está activo.\n' "$active"
    exit 0
fi

# Conserva cualquier ajuste realizado desde el último cambio de perfil.
if [ -d "$profile_root/$active/qtile" ]; then
    rsync -a --delete \
        --exclude='*.backup*' --exclude='__pycache__/' --exclude='*.pyc' \
        --exclude='workspace-themes.json' \
        "$qtile_target/" "$profile_root/$active/qtile/"
    cp -a "$picom_target" "$profile_root/$active/picom.conf"
    cp -a "$kitty_target" "$profile_root/$active/kitty.conf"
fi

source_dir="$profile_root/$command_name"
rsync -a --delete \
    --exclude='*.backup*' --exclude='__pycache__/' --exclude='*.pyc' \
    --exclude='workspace-themes.json' \
    "$source_dir/qtile/" "$qtile_target/"
cp -a "$source_dir/picom.conf" "$picom_target"
cp -a "$source_dir/kitty.conf" "$kitty_target"
if [ -x "$HOME/.local/bin/animation-profile" ]; then
    "$HOME/.local/bin/animation-profile" reapply --no-restart >/dev/null
fi
printf '%s\n' "$command_name" > "$active_file"

if [ "$command_name" != "premium" ] && [ -x "$HOME/.local/bin/macwidgets" ]; then
    "$HOME/.local/bin/macwidgets" stop 2>/dev/null || true
fi

printf 'Perfil activado: %s\n' "$command_name"

if [ "$apply_now" = "--apply" ]; then
    pkill picom 2>/dev/null || true
    setsid -f picom --config "$picom_target"
    qtile cmd-obj -o cmd -f restart >/dev/null 2>&1 || true
else
    printf '%s\n' 'Pulsa Mod+Ctrl+R para aplicarlo.'
fi
