#!/bin/sh

output='eDP-1'
touchscreen='ELAN9024:00 04F3:4296'
property='Coordinate Transformation Matrix'

usage() {
    echo "Uso: rotate {normal|left|right|inverted|status}" >&2
}

orientation() {
    line=$(xrandr --query | awk -v output="$output" '$1 == output && $2 == "connected" { print; exit }')
    case "$line" in
        *' left ('*) echo left ;;
        *' right ('*) echo right ;;
        *' inverted ('*) echo inverted ;;
        *) echo normal ;;
    esac
}

matrix() {
    xinput list-props "$touchscreen" |
        awk -F: '/^[[:space:]]*Coordinate Transformation Matrix \(/ {
            sub(/^[[:space:]]*/, "", $2)
            print $2
            exit
        }'
}

if [ "$#" -ne 1 ]; then
    usage
    exit 2
fi

if ! command -v xrandr >/dev/null 2>&1 || ! command -v xinput >/dev/null 2>&1; then
    echo "Error: se requieren xrandr y xinput." >&2
    exit 1
fi

if ! xrandr --query | awk -v output="$output" '$1 == output && $2 == "connected" { found=1 } END { exit !found }'; then
    echo "Error: no se encontró la pantalla $output." >&2
    exit 1
fi

if ! xinput list --id-only "$touchscreen" >/dev/null 2>&1; then
    echo "Error: no se encontró el touchscreen $touchscreen." >&2
    exit 1
fi

if [ "$1" = status ]; then
    echo "Orientación: $(orientation)"
    echo "Touchscreen: $touchscreen"
    echo "Matriz: $(matrix)"
    exit 0
fi

case "$1" in
    normal)   new_matrix='1 0 0 0 1 0 0 0 1' ;;
    left)     new_matrix='0 -1 1 1 0 0 0 0 1' ;;
    right)    new_matrix='0 1 0 -1 0 1 0 0 1' ;;
    inverted) new_matrix='-1 0 1 0 -1 1 0 0 1' ;;
    *)
        usage
        exit 2
        ;;
esac

old_matrix=$(matrix | tr -d ',')
if [ -z "$old_matrix" ]; then
    echo "Error: no se pudo leer la matriz actual del touchscreen." >&2
    exit 1
fi

# La expansión sin comillas separa los nueve valores requeridos por xinput.
if ! xinput set-prop "$touchscreen" "$property" $new_matrix; then
    echo "Error: no se pudo rotar el touchscreen." >&2
    exit 1
fi

if ! xrandr --output "$output" --rotate "$1"; then
    xinput set-prop "$touchscreen" "$property" $old_matrix >/dev/null 2>&1
    echo "Error: no se pudo rotar la pantalla; se restauró el touchscreen." >&2
    exit 1
fi

echo "Rotación: $1"
