def current_profile():
    try:
        value = STATE.read_text(encoding="utf-8").strip()
    except OSError:
        value = "premium"
    return value if value in PROFILES else "premium"


def choose_profile():
    labels = {
        "Premium — zoom equilibrado": "premium",
        "Suave — zoom lento": "suave",
        "Rápida — respuesta inmediata": "rapida",
        "Deslizar — movimiento lateral": "deslizar",
        "Volar — entrada y salida vertical": "volar",
        "Sin animaciones": "ninguna",
    }
    result = subprocess.run(
        ["rofi", "-dmenu", "-i", "-p", "Animaciones"],
        input="\n".join(labels) + "\n",
        text=True,
        capture_output=True,
        check=False,
    )
    return labels.get(result.stdout.strip()) if result.returncode == 0 else None


def find_animation_block(text):
    marker = "animations"
    start = text.find(marker)
    while start >= 0:
        equals = text.find("=", start + len(marker))
        opening = text.find("(", equals + 1) if equals >= 0 else -1
        if opening >= 0 and text[equals + 1:opening].strip() == "":
            depth = 0
            quoted = False
            escaped = False
            for index in range(opening, len(text)):
                char = text[index]
                if escaped:
                    escaped = False
                    continue
                if char == "\\" and quoted:
                    escaped = True
                elif char == '"':
                    quoted = not quoted
                elif not quoted and char == "(":
                    depth += 1
                elif not quoted and char == ")":
                    depth -= 1
                    if depth == 0:
                        semicolon = text.find(";", index)
                        if semicolon >= 0:
                            return start, semicolon + 1
                        break
        start = text.find(marker, start + len(marker))
    return None


def apply_profile(name):
    text = CONFIG.read_text(encoding="utf-8")
    bounds = find_animation_block(text)
    block = PROFILES[name]
    if bounds:
        start, end = bounds
        updated = text[:start] + block + text[end:]
    else:
        updated = text.rstrip() + "\n\n" + block + "\n"
    temporary = CONFIG.with_suffix(".conf.tmp")
    temporary.write_text(updated, encoding="utf-8")
    temporary.replace(CONFIG)
    STATE.write_text(name + "\n", encoding="utf-8")


def restart_picom():
    subprocess.run(["pkill", "picom"], check=False)
    time.sleep(0.15)
    subprocess.Popen(
        ["picom", "--config", str(CONFIG)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else None
    no_restart = "--no-restart" in sys.argv[2:]
    if command == "status":
        print(f"Perfil de animación: {current_profile()}")
        return 0
    if command == "reapply":
        selected = current_profile()
    elif command in PROFILES:
        selected = command
    elif command is None:
        selected = choose_profile()
        if selected is None:
            return 0
    else:
        print("Uso: animation-profile [premium|suave|rapida|deslizar|volar|ninguna|status]", file=sys.stderr)
        return 2
    apply_profile(selected)
    if not no_restart:
        restart_picom()
    print(f"Animación activa: {selected}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
